# Code your family uses to sign in (at least 6 characters)
FAMILY_CODE=change-me-family

# Code for you as admin: sees and manages all requests (must differ from FAMILY_CODE)
ADMIN_CODE=change-me-admin

PORT=3000
DATA_DIR=./data

# Set to "true" once the app is served over HTTPS (e.g. behind Nginx Proxy Manager or a Cloudflare Tunnel)
COOKIE_SECURE=false

# Behind a reverse proxy: header that carries the real visitor IP, so the login lockout applies per visitor.
# Nginx Proxy Manager: x-real-ip · Cloudflare Tunnel: cf-connecting-ip · No proxy: leave empty
# Only set this if the app is reachable exclusively through the proxy, otherwise the header can be spoofed.
CLIENT_IP_HEADER=

# Optional: Bambu Lab printer on your LAN (set all three or none)
# IP: printer screen → network settings
# Serial number and access code: printer screen → device info / LAN settings
PRINTER_HOST=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=
