{
  "name": "druckwunsch",
  "version": "0.6.0",
  "private": true,
  "description": "Self-hosted print queue for family 3D printing requests from MakerWorld, with Bambu Lab printer integration",
  "license": "MIT",
  "author": "luka-lta",
  "homepage": "https://github.com/luka-lta/druckwunsch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luka-lta/druckwunsch.git"
  },
  "bugs": {
    "url": "https://github.com/luka-lta/druckwunsch/issues"
  },
  "keywords": [
    "3d-printing",
    "bambu-lab",
    "makerworld",
    "self-hosted",
    "print-queue",
    "family"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --names server,web --prefix-colors blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file=.env server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "printer:probe": "tsx --env-file=.env server/Printer/probe.ts",
    "deploy": "scripts/deploy.sh",
    "docker:push": "scripts/docker-push.sh",
    "demo": "npm run build:web && tsx scripts/demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "mqtt": "^5.16.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
